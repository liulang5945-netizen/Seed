{
  "name": "@taiji/dsh-web-search-scraper",
  "description": "Native scraper search provider (no credential; fetches and parses search-engine result pages) for the DeepSeek Harness web capability seam (ctx.web)",
  "version": "0.1.7-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/web/web-search-scraper"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@taiji/dsh-web": "workspace:^",
    "@taiji/cordis": "workspace:^"
  },
  "dependencies": {
    "@taiji/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@taiji/dsh-web": "workspace:^",
    "@taiji/cordis": "workspace:^",
    "@taiji/dsh-http-proxy": "workspace:^",
    "@taiji/dsh-launch-environment": "workspace:^"
  }
}
