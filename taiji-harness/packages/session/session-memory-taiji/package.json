{
  "name": "@taiji/dsh-session-memory-taiji",
  "description": "Report each top-level Taiji Host turn's prompt and answer to the local runtime's durable memory journal",
  "version": "0.1.7-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/session-memory-taiji"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@taiji/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@taiji/cordis": "workspace:^",
    "@taiji/dsh-agent": "workspace:^",
    "@taiji/dsh-session": "workspace:^"
  },
  "devDependencies": {
    "@taiji/cordis": "workspace:^",
    "@taiji/dsh-agent": "workspace:^",
    "@taiji/dsh-llm": "workspace:^",
    "@taiji/dsh-session": "workspace:^"
  }
}