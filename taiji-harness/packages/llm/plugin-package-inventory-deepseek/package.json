{
  "name": "@taiji/dsh-plugin-package-inventory-deepseek",
  "description": "Active Loader-backed plugin package inventory for official DeepSeek LLM API requests",
  "version": "0.1.7-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/plugin-package-inventory-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@taiji/dsh-brand": "workspace:^",
    "@taiji/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@taiji/cordis": "workspace:^",
    "@taiji/cordis-plugin-loader": "workspace:^",
    "@taiji/dsh-agent": "workspace:^",
    "@taiji/dsh-agent-preset-registry": "workspace:^",
    "@taiji/dsh-deepseek-llm-api-extensions": "workspace:^",
    "@taiji/dsh-session": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@taiji/dsh-agent-preset-registry": {
      "optional": true
    }
  },
  "devDependencies": {
    "@taiji/dsh-app-boot": "workspace:^",
    "@taiji/cordis": "workspace:^",
    "@taiji/cordis-plugin-include": "workspace:^",
    "@taiji/cordis-plugin-loader": "workspace:^",
    "@taiji/dsh-agent": "workspace:^",
    "@taiji/dsh-agent-preset-registry": "workspace:^",
    "@taiji/dsh-deepseek-llm-api-extensions": "workspace:^",
    "@taiji/dsh-scope": "workspace:^",
    "@taiji/dsh-session": "workspace:^",
    "@taiji/dsh-session-projection": "workspace:^"
  }
}
