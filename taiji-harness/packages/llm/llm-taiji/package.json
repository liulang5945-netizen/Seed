{
  "name": "@taiji/dsh-llm-taiji",
  "description": "Taiji local-runtime adapter",
  "version": "0.1.7-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/llm-taiji"
  },
