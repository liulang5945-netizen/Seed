{
  "name": "@taiji/dsh-plugin-manager",
  "description": "Current-profile plugin and bundle management shared by dsh CLI, Web and agent tools",
  "version": "0.1.7-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/boot/plugin-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./registry": {
      "types": "./lib/types/registry.d.ts",
      "default": "./lib/types/registry.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./operations": {
      "types": "./lib/types/operations.d.ts",
      "default": "./lib/types/operations.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@taiji/dsh-app-boot": "workspace:^",
    "@taiji/dsh-atomic-write": "workspace:^",
    "@taiji/schemastery": "workspace:^",
    "execa": "^10.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "@taiji/dsh-util-values": "workspace:^"
  },
  "peerDependencies": {
    "@taiji/cordis": "workspace:^",
    "@taiji/cordis-plugin-loader": "workspace:^",
    "@taiji/dsh-host-plugin-inventory": "workspace:^",
    "@taiji/dsh-subprocess": "workspace:^",
    "@taiji/dsh-typert-protocol": "workspace:^",
    "@taiji/dsh-tools": "workspace:^",
    "@taiji/dsh-hmr": "workspace:^",
    "@taiji/dsh-brand": "workspace:^",
    "@taiji/dsh-sandbox-policy": "workspace:^",
    "@taiji/dsh-sandbox": "workspace:^",
    "@taiji/dsh-user-approval": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@taiji/dsh-hmr": {
      "optional": true
    },
    "@taiji/dsh-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "@taiji/dsh-package-manifest": "workspace:^",
    "@taiji/cordis": "workspace:^",
    "@taiji/cordis-plugin-loader": "workspace:^",
    "@taiji/dsh-host-plugin-inventory": "workspace:^",
    "@taiji/dsh-subprocess": "workspace:^",
    "@taiji/dsh-typert-protocol": "workspace:^",
    "@taiji/dsh-tools": "workspace:^",
    "@taiji/dsh-system-prompt": "workspace:^",
    "@taiji/dsh-hmr": "workspace:^",
    "@taiji/cordis-plugin-timer": "workspace:^",
    "@taiji/dsh-brand": "workspace:^",
    "@taiji/dsh-sandbox-policy": "workspace:^",
    "@taiji/dsh-agent": "workspace:^",
    "@taiji/dsh-session": "workspace:^",
    "@taiji/dsh-session-projection": "workspace:^",
    "@taiji/dsh-sandbox": "workspace:^",
    "@taiji/dsh-user-approval": "workspace:^"
  }
}
