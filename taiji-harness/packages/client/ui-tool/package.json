{
  "name": "@taiji/dsh-client-ui-tool",
  "description": "Client Tool call-tree renderer and keyed per-tool presentation slot",
  "version": "0.1.7-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-tool"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@taiji/dsh-api-workspace-controller",
        "@taiji/dsh-client-connection",
        "@taiji/dsh-client-locale",
        "@taiji/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@taiji/cordis": "workspace:^"
  },
  "devDependencies": {
    "@taiji/dsh-spill-policy": "workspace:^",
    "@taiji/dsh-agent": "workspace:^",
    "@taiji/dsh-llm": "workspace:^",
    "@taiji/dsh-session": "workspace:^",
    "@taiji/dsh-system-prompt": "workspace:^",
    "@taiji/dsh-tools": "workspace:^",
    "@taiji/dsh-tool-jobs": "workspace:^",
    "@taiji/dsh-tool-session-query": "workspace:^",
    "@taiji/dsh-tool-terminal": "workspace:^",
    "@taiji/dsh-spill": "workspace:^",
    "@taiji/cordis": "workspace:^",
    "@taiji/dsh-api-remotes": "workspace:^",
    "@taiji/dsh-client-connection": "workspace:^",
    "@taiji/dsh-client-locale": "workspace:^",
    "@taiji/dsh-client-test-runtime": "workspace:^",
    "@taiji/dsh-client-ui-conversation": "workspace:^",
    "@taiji/dsh-client-ui-primitives": "workspace:^",
    "@taiji/dsh-client-ui-slots": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@taiji/dsh-api-workspace-controller": "workspace:^",
    "@taiji/dsh-client-ui-chat": "workspace:^",
    "@taiji/dsh-client-ui-renderer": "workspace:^",
    "@taiji/dsh-client-ui-session": "workspace:^",
    "@taiji/dsh-util-workspace-path": "workspace:^",
    "@taiji/dsh-attachment": "workspace:^",
    "clsx": "^2.0.0",
    "@taiji/dsh-ptc-runtime": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
