{
  "name": "@taiji/dsh-client-ui-settings-general",
  "description": "Settings ownerless-copy and product onboarding plugin: the General section, shell trigger/header chrome content, settings dictionaries, and the versioned welcome notice",
  "version": "0.1.7-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-settings-general"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@taiji/dsh-client-ui-settings",
        "@taiji/dsh-client-locale",
        "@taiji/dsh-client-connection",
        "@taiji/dsh-api-remotes",
        "@taiji/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@taiji/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@taiji/cordis": "workspace:^"
  },
  "devDependencies": {
    "@taiji/cordis": "workspace:^",
    "@taiji/dsh-api-remotes": "workspace:^",
    "@taiji/dsh-client-connection": "workspace:^",
    "@taiji/dsh-client-locale": "workspace:^",
    "@taiji/dsh-client-store": "workspace:^",
    "@taiji/dsh-client-test-runtime": "workspace:^",
    "@taiji/dsh-client-ui-primitives": "workspace:^",
    "@taiji/dsh-client-ui-renderer": "workspace:^",
    "@taiji/dsh-client-ui-session": "workspace:^",
    "@taiji/dsh-client-ui-settings": "workspace:^",
    "@taiji/dsh-client-ui-sidebar": "workspace:^",
    "@taiji/dsh-client-ui-slots": "workspace:^",
    "@taiji/dsh-remote-mock": "workspace:^",
    "@types/react": "~18.3.1",
    "clsx": "^2.0.0",
    "react": "^18.2.0",
    "@taiji/dsh-settings": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
