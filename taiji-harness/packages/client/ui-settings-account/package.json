{
  "name": "@taiji/dsh-client-ui-settings-account",
  "description": "Manage DeepSeek login and open Platform billing pages",
  "version": "0.1.7-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-settings-account"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@taiji/dsh-api-remotes",
        "@taiji/dsh-client-ui-settings",
        "@taiji/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@taiji/cordis": "workspace:^"
  },
  "devDependencies": {
    "@taiji/cordis": "workspace:^",
    "@taiji/dsh-api-remotes": "workspace:^",
    "@taiji/dsh-client-locale": "workspace:^",
    "@taiji/dsh-client-test-runtime": "workspace:^",
    "@taiji/dsh-client-ui-primitives": "workspace:^",
    "@taiji/dsh-client-ui-renderer": "workspace:^",
    "@taiji/dsh-client-ui-settings": "workspace:^",
    "@taiji/dsh-client-ui-slots": "workspace:^",
    "@taiji/dsh-deepseek-account": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/big.js": "^6.2.2",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@taiji/dsh-client-ui-settings-models": "workspace:^",
    "@types/react-dom": "~18.3.0",
    "@taiji/dsh-host-webserver": "workspace:^",
    "big.js": "^7.0.1"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@taiji/schemastery": "workspace:^"
  }
}
