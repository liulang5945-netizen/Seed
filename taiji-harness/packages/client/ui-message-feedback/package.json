{
  "name": "@taiji/dsh-client-ui-message-feedback",
  "description": "The Web feedback surface: per-message Like/Dislike in the assistant-message action strip and the feedback dialog behind both ratings and /feedback, backed by the messageFeedback and sessionFeedback Host Remotes",
  "version": "0.1.7-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-message-feedback"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@taiji/dsh-api-remotes",
        "@taiji/dsh-client-locale",
        "@taiji/dsh-client-ui-conversation",
        "@taiji/dsh-client-ui-renderer",
        "@taiji/dsh-client-ui-commands"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@taiji/cordis": "workspace:^"
  },
  "devDependencies": {
    "@taiji/dsh-api-remotes": "workspace:^",
    "@taiji/dsh-client-connection": "workspace:^",
    "@taiji/dsh-client-locale": "workspace:^",
    "@taiji/dsh-client-test-runtime": "workspace:^",
    "@taiji/dsh-client-ui-conversation": "workspace:^",
    "@taiji/dsh-client-ui-primitives": "workspace:^",
    "@taiji/dsh-client-ui-renderer": "workspace:^",
    "@taiji/dsh-client-ui-slots": "workspace:^",
    "@taiji/dsh-message-feedback": "workspace:^",
    "@taiji/dsh-remote-mock": "workspace:^",
    "@taiji/dsh-session": "workspace:^",
    "@taiji/dsh-typert-protocol": "workspace:^",
    "@taiji/cordis": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@taiji/dsh-client-ui-chat": "workspace:^",
    "@taiji/dsh-client-ui-session": "workspace:^",
    "@taiji/dsh-client-ui-commands": "workspace:^",
    "@taiji/dsh-command-feedback": "workspace:^",
    "@taiji/dsh-client-store": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
