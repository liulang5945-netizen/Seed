{
  "name": "@taiji/dsh-experimental-browser-use-runtime",
  "description": "Session-owned browser resource lifecycles and MCP integration for experimental providers",
  "version": "0.1.7-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/browser-use-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./mcp": {
      "types": "./lib/types/mcp.d.ts",
      "default": "./lib/types/mcp.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@taiji/cordis": "workspace:^",
    "@taiji/dsh-agent": "workspace:^",
    "@taiji/dsh-browser-use": "workspace:^",
    "@taiji/dsh-mcp-client": "workspace:^",
    "@taiji/dsh-scope": "workspace:^",
    "@taiji/dsh-tools": "workspace:^",
    "@taiji/dsh-system-prompt": "workspace:^"
  },
  "dependencies": {
    "@taiji/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@taiji/cordis": "workspace:^",
    "@taiji/dsh-agent": "workspace:^",
    "@taiji/dsh-browser-use": "workspace:^",
    "@taiji/dsh-mcp-client": "workspace:^",
    "@taiji/dsh-scope": "workspace:^",
    "@taiji/dsh-tools": "workspace:^",
    "@taiji/dsh-agent-loop-testkit": "workspace:^",
    "@taiji/dsh-agent-loop": "workspace:^",
    "@taiji/dsh-session": "workspace:^",
    "@taiji/dsh-session-projection": "workspace:^",
    "@taiji/dsh-system-prompt": "workspace:^",
    "@taiji/dsh-mcp-resources": "workspace:^",
    "@taiji/dsh-ptc-runtime": "workspace:^",
    "@taiji/dsh-llm": "workspace:^",
    "@taiji/cordis-plugin-loader": "workspace:^",
    "@taiji/cordis-plugin-include": "workspace:^",
    "@taiji/dsh-attachment-local": "workspace:^",
    "@taiji/dsh-session-persistence-jsonl": "workspace:^"
  }
}
