{
  "name": "@taiji/dsh-experimental-browser-use-playwright-mcp",
  "description": "Experimental per-Session Chromium browser tools through @playwright/mcp",
  "version": "0.1.7-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/browser-use-playwright-mcp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@taiji/dsh-experimental-browser-use-runtime": "workspace:^",
    "@playwright/mcp": "0.0.80"
  },
  "peerDependencies": {
    "@taiji/cordis": "workspace:^",
    "@taiji/dsh-browser-use": "workspace:^",
    "@taiji/dsh-agent": "workspace:^",
    "@taiji/dsh-tools": "workspace:^",
    "@taiji/dsh-system-prompt": "workspace:^"
  },
  "devDependencies": {
    "@taiji/cordis": "workspace:^",
    "@taiji/cordis-plugin-loader": "workspace:^",
    "@taiji/cordis-plugin-include": "workspace:^",
    "@taiji/dsh-browser-use": "workspace:^",
    "@taiji/dsh-agent": "workspace:^",
    "@taiji/dsh-agent-loop": "workspace:^",
    "@taiji/dsh-llm": "workspace:^",
    "@taiji/dsh-session": "workspace:^",
    "@taiji/dsh-tools": "workspace:^",
    "@taiji/dsh-system-prompt": "workspace:^",
    "@taiji/dsh-session-projection": "workspace:^"
  }
}
