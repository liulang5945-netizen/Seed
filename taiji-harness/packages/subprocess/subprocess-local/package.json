{
  "name": "@taiji/dsh-subprocess-local",
  "description": "Local-subprocess implementation of the DeepSeek Harness subprocess seam",
  "version": "0.1.7-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subprocess/subprocess-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./runner": {
      "types": "./lib/types/bin.d.ts",
      "default": "./lib/runner.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./output": {
      "types": "./lib/types/output.d.ts",
      "default": "./lib/output.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/runner.js",
    "lib/runner-*.js",
    "lib/output.js",
    "scripts/ensure-spawn-helper.mjs",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "postinstall": "node scripts/ensure-spawn-helper.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@taiji/dsh-subprocess": "workspace:^",
    "@taiji/dsh-timeout": "workspace:^",
    "@taiji/cordis": "workspace:^"
  },
  "dependencies": {
    "@taiji/dsh-lazy-require": "workspace:^",
    "@taiji/dsh-win32-process": "workspace:^",
    "koffi": "^3.1.0",
    "node-pty": "1.2.0-beta.15"
  },
  "devDependencies": {
    "@taiji/dsh-loader-smoke": "workspace:^",
    "@taiji/dsh-subprocess": "workspace:^",
    "@taiji/dsh-timeout": "workspace:^",
    "@taiji/cordis": "workspace:^"
  }
}
