{
  "name": "@taiji/dsh-time-context",
  "description": "Opt-in durable per-step context with the current time and elapsed time",
  "version": "0.1.7-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/context/time-context"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@taiji/dsh-util-values": "workspace:^",
    "@taiji/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@taiji/cordis": "workspace:^",
    "@taiji/dsh-agent": "workspace:^",
    "@taiji/dsh-invariants": "workspace:^",
    "@taiji/dsh-llm": "workspace:^",
    "@taiji/dsh-session": "workspace:^",
    "@taiji/dsh-session-projection": "workspace:^"
  },
  "devDependencies": {
    "@taiji/cordis": "workspace:^",
    "@taiji/dsh-agent": "workspace:^",
    "@taiji/dsh-agent-loop": "workspace:^",
    "@taiji/dsh-agent-loop-testkit": "workspace:^",
    "@taiji/dsh-app-boot": "workspace:^",
    "@taiji/dsh-bash-local": "workspace:^",
    "@taiji/dsh-invariants": "workspace:^",
    "@taiji/dsh-llm": "workspace:^",
    "@taiji/dsh-loader-smoke": "workspace:^",
    "@taiji/dsh-session": "workspace:^",
    "@taiji/dsh-session-checkpoint-policy": "workspace:^",
    "@taiji/dsh-session-persistence-jsonl": "workspace:^",
    "@taiji/dsh-session-projection": "workspace:^",
    "@taiji/dsh-subprocess-local": "workspace:^",
    "@taiji/dsh-system-prompt": "workspace:^",
    "@taiji/dsh-tools": "workspace:^"
  }
}
