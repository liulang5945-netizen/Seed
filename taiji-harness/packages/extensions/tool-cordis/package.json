{
  "name": "@taiji/dsh-tool-cordis",
  "description": "Read-only runtime API inspection for Harness plugin development",
  "version": "0.1.7-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/extensions/tool-cordis"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./host": {
      "types": "./lib/types/host.d.ts",
      "default": "./lib/types/host.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@taiji/cordis": "workspace:^",
    "@taiji/cordis-plugin-loader": "workspace:^",
    "@taiji/dsh-agent": "workspace:^",
    "@taiji/dsh-app-boot": "workspace:^",
    "@taiji/dsh-cordis-host-runner": "workspace:^",
    "@taiji/dsh-tools": "workspace:^"
  },
  "devDependencies": {
    "@taiji/cordis": "workspace:^",
    "@taiji/cordis-plugin-group": "workspace:^",
    "@taiji/cordis-plugin-loader": "workspace:^",
    "@taiji/dsh-agent": "workspace:^",
    "@taiji/dsh-app-boot": "workspace:^",
    "@taiji/dsh-cordis-host-runner": "workspace:^",
    "@taiji/dsh-system-prompt": "workspace:^",
    "@taiji/dsh-tools": "workspace:^",
    "@taiji/schemastery": "workspace:^"
  }
}
