{
  "name": "@taiji/dsh-agent-preset-registry",
  "description": "Declarative Agent preset registry and profile-backed editing",
  "version": "0.1.7-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/preset/agent-preset-registry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./display": {
      "types": "./lib/types/display.d.ts",
      "default": "./lib/types/display.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@taiji/cordis-plugin-loader": "workspace:^",
    "@taiji/dsh-agent": "workspace:^",
    "@taiji/dsh-invariants": "workspace:^",
    "@taiji/dsh-scope": "workspace:^",
    "@taiji/dsh-session": "workspace:^",
    "@taiji/dsh-session-projection": "workspace:^",
    "@taiji/dsh-settings": "workspace:^",
    "@taiji/dsh-system-prompt": "workspace:^",
    "@taiji/dsh-tools": "workspace:^",
    "@taiji/dsh-typert-protocol": "workspace:^",
    "@taiji/cordis": "workspace:^"
  },
  "dependencies": {
    "@taiji/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@taiji/dsh-app-boot": "workspace:^",
    "@taiji/cordis-plugin-group": "workspace:^",
    "@taiji/cordis-plugin-include": "workspace:^",
    "@taiji/cordis-plugin-loader": "workspace:^",
    "@taiji/dsh-agent": "workspace:^",
    "@taiji/dsh-agent-loop": "workspace:^",
    "@taiji/dsh-atomic-write": "workspace:^",
    "@taiji/dsh-invariants": "workspace:^",
    "@taiji/dsh-llm": "workspace:^",
    "@taiji/dsh-scope": "workspace:^",
    "@taiji/dsh-session": "workspace:^",
    "@taiji/dsh-session-projection": "workspace:^",
    "@taiji/dsh-settings": "workspace:^",
    "@taiji/dsh-system-prompt": "workspace:^",
    "@taiji/dsh-tools": "workspace:^",
    "@taiji/dsh-typert-protocol": "workspace:^",
    "@taiji/cordis": "workspace:^",
    "@taiji/dsh-hmr": "workspace:^",
    "@taiji/dsh-sandbox": "workspace:^",
    "@taiji/dsh-sandbox-policy": "workspace:^",
    "@taiji/dsh-user-approval": "workspace:^",
    "@taiji/dsh-agent-preset": "workspace:^"
  }
}
