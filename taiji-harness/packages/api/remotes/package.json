{
  "name": "@taiji/dsh-api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.1.7-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@taiji/dsh-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@taiji/dsh-deque": "workspace:^",
    "@taiji/dsh-session": "workspace:^",
    "@taiji/dsh-util-values": "workspace:^"
  },
  "peerDependencies": {
    "@taiji/cordis": "workspace:^",
    "@taiji/dsh-scope": "workspace:^"
  },
  "devDependencies": {
    "@taiji/cordis": "workspace:^",
    "@taiji/dsh-agent": "workspace:^",
    "@taiji/dsh-agent-preset-registry": "workspace:^",
    "@taiji/dsh-api-gateway": "workspace:^",
    "@taiji/dsh-api-job-controller": "workspace:^",
    "@taiji/dsh-api-session-controller": "workspace:^",
    "@taiji/dsh-api-settings-controller": "workspace:^",
    "@taiji/dsh-api-workspace-controller": "workspace:^",
    "@taiji/dsh-client-connection": "workspace:^",
    "@taiji/dsh-client-file-upload": "workspace:^",
    "@taiji/dsh-commands": "workspace:^",
    "@taiji/dsh-cordis-host-runner": "workspace:^",
    "@taiji/dsh-credentials": "workspace:^",
    "@taiji/dsh-file-reference": "workspace:^",
    "@taiji/dsh-goal": "workspace:^",
    "@taiji/dsh-host-plugin-inventory": "workspace:^",
    "@taiji/dsh-llm": "workspace:^",
    "@taiji/dsh-message-feedback": "workspace:^",
    "@taiji/dsh-scope": "workspace:^",
    "@taiji/dsh-permission-presets": "workspace:^",
    "@taiji/dsh-session-reference": "workspace:^",
    "@taiji/dsh-settings": "workspace:^",
    "@taiji/dsh-subagent": "workspace:^",
    "@taiji/dsh-typert-protocol": "workspace:^",
    "@taiji/dsh-user-approval": "workspace:^",
    "@taiji/dsh-user-questions": "workspace:^",
    "@taiji/dsh-client-connection": "workspace:^",
    "@taiji/dsh-client-file-upload": "workspace:^",
    "@taiji/dsh-typert-protocol": "workspace:^",
    "@taiji/dsh-scope": "workspace:^",
    "@taiji/dsh-api-session-controller": "workspace:^",
    "@taiji/dsh-api-workspace-files": "workspace:^",
    "zod": "^4.4.3",
    "@taiji/dsh-command-feedback": "workspace:^",
    "@taiji/dsh-api-terminal-controller": "workspace:^",
    "@taiji/dsh-plugin-manager": "workspace:^",
    "@taiji/dsh-office-to-pdf": "workspace:^",
    "@taiji/dsh-api-account-controller": "workspace:^"
  }
}
