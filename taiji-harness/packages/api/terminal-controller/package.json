{
  "name": "@taiji/dsh-api-terminal-controller",
  "description": "Session-owned interactive terminals with shell discovery, screen recovery and typed Remote control",
  "version": "0.1.7-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/terminal-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@taiji/dsh-api-gateway"
      ],
      "external": [
        "@taiji/dsh-api-gateway/client"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@taiji/dsh-deque": "workspace:^",
    "@taiji/dsh-lazy-require": "workspace:^",
    "@taiji/dsh-typert-protocol": "workspace:^",
    "@taiji/schemastery": "workspace:^",
    "@xterm/headless": "^6.0.0",
    "@xterm/addon-serialize": "^0.14.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@taiji/dsh-subprocess": "workspace:^",
    "@taiji/cordis": "workspace:^"
  },
  "devDependencies": {
    "@taiji/cordis": "workspace:^",
    "@taiji/dsh-agent": "workspace:^",
    "@taiji/dsh-api-gateway": "workspace:^",
    "@taiji/dsh-brand": "workspace:^",
    "@taiji/dsh-client-store": "workspace:^",
    "@taiji/dsh-fs": "workspace:^",
    "@taiji/dsh-remote-mock": "workspace:^",
    "@taiji/dsh-sandbox": "workspace:^",
    "@taiji/dsh-sandbox-policy": "workspace:^",
    "@taiji/dsh-session": "workspace:^",
    "@taiji/dsh-session-projection": "workspace:^",
    "@taiji/dsh-subprocess": "workspace:^",
    "@taiji/dsh-subprocess-local": "workspace:^",
    "@taiji/dsh-util-crypto": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ]
}
