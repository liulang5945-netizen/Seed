    "directory": "packages/subagent/subagent-acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@taiji/cordis": "workspace:^",
    "@taiji/dsh-agent": "workspace:^",
    "@taiji/dsh-llm": "workspace:^",
    "@taiji/dsh-session": "workspace:^",
    "@taiji/dsh-subagent": "workspace:^",
    "@taiji/dsh-subprocess": "workspace:^",
    "@taiji/dsh-timeout": "workspace:^"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@taiji/dsh-brand": "workspace:^",
    "@taiji/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@taiji/cordis": "workspace:^",
    "@taiji/cordis-plugin-loader": "workspace:^",
    "@taiji/dsh-agent": "workspace:^",
    "@taiji/dsh-app-boot": "workspace:^",
    "@taiji/dsh-llm": "workspace:^",
    "@taiji/dsh-loader-smoke": "workspace:^",
    "@taiji/dsh-session": "workspace:^",
    "@taiji/dsh-session-checkpoint-policy": "workspace:^",
    "@taiji/dsh-session-persistence-jsonl": "workspace:^",
    "@taiji/dsh-session-projection": "workspace:^",
    "@taiji/dsh-subagent": "workspace:^",
    "@taiji/dsh-subprocess": "workspace:^",
    "@taiji/dsh-subprocess-local": "workspace:^",
    "@taiji/dsh-timeout": "workspace:^",
    "@taiji/dsh-tool-subagent": "workspace:^"
