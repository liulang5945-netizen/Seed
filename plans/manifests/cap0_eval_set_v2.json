  "declared_mode": "N",
  "mode_note": "N = native content and language output. E/T modes must not be scored as N answer ability.",
  "scoring_scales": {
    "rubric_0_1_2": {
      "0": "错误 / 无关 / 未答",
      "1": "部分正确或方向正确但缺少关键要素",
      "2": "正确且满足约束"
    },
    "exact": "固定答案题：精确匹配或规则匹配（见 expected_contains），全或无",
    "behaviour": "行为判定：expected_behaviour 命中记通过；未命中记失败并归因"
  },
