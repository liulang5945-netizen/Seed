    "A": {
      "name": "模型真实性",
      "count": 6,
      "scoring": "pass_fail",
      "items": [
        {
          "id": "A01",
          "check": "新进程加载不重新 fit（不训练、不初始化外部模型）",
          "pass_when": "全新进程直接加载并回答，过程中无 fit/train 调用、无网络下载"
        },
        {
          "id": "A02",
          "check": "缺 checkpoint 确定性拒绝",
          "pass_when": "指定不存在的 checkpoint 时确定性报错，不静默下载或随机初始化"
        },
        {
          "id": "A03",
          "check": "固定输入可复现",
          "pass_when": "同进程内对同一输入两次请求得到相同原始输出"
        },
        {
          "id": "A04",
          "check": "输入确实影响参数驱动的原始输出",
          "pass_when": "追踪到实际 decoder 输出；改写输入后输出随之变化，而非固定模板"
        },
        {
          "id": "A05",
          "check": "受控消融（隔离副本）揭示贡献",
          "pass_when": "在副本上扰动权重或关闭记忆后输出变化；副本外文件哈希不变"
        },
        {
          "id": "A06",
          "check": "模式隔离：N 模式不得调用外部生成",
          "pass_when": "N 模式下无外部 provider 调用；移除外部件后输出仍可产生"
        }
      ]
    },
