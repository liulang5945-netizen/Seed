 "definition": {
  "pair_read": "one sentence carries two written keys; the two-pass read returns one value per slot (object and place); the slot is read from the value, and the key text is read from the record",
  "loop": "one iteration compares each slot with the frozen verifier and submits one correct batch containing only the mismatched slots, using each slot's read value as its credential",
  "single_slot": "object CUP -> RED with place already TABLE; only the object key may move",
  "both_slots": "object CUP -> RED and place TABLE -> SHELF in one batch; both must move",
  "stale_subset": "capture (CUP, TABLE), another actor corrects place to SHELF, then submit both corrections from the stale pair; the batch must be rejected whole, so object stays CUP",
  "no_op": "both read values equal the verifier: no correction, empty log, digest unchanged",
  "plain_write": "a plain write of the old value is still rejected; correction is the only path",
  "convergence": "two iterations: the first corrects, the second agrees; exactly one log entry",
  "default_table": "on the 18-key table, correct the two keys of a describe sentence to another pair and back; content digest returns to the original, R15 40/40, zeros 0/0",
  "closed_state": "the nine closed-state readings stay equal before and after"
 },
 "criteria": {
  "single_slot": "action corrected with one item; read (CUP, TABLE) -> (RED, TABLE); log length 1; the log key is the object key",
  "both_slots": "action corrected with two items; read (CUP, TABLE) -> (RED, SHELF); log length 2 in object then place order",
  "stale_subset": "action rejected_batch_correction_mismatch; read stays (CUP, SHELF); log length 1; content digest unchanged",
  "no_op": "action agreed; no correction; log empty; content digest unchanged",
  "plain_write": "action rejected_batch_address_already_bound; read stays (CUP, TABLE); log empty; content digest unchanged",
  "convergence": "first corrected, second agreed, log length 1, final (RED, TABLE)",
  "default_table": "first batch corrects two keys, second batch restores them; content digest equal; regression 40/40 with wrong 0; zeros 0/0; log length 4",
  "closed_state": "the nine closed-state readings stay equal before and after",
  "reporting": "segments are reported separately; a single-slot correction does not carry the stale-subset segment, and the stale segment is evidence that the batch is atomic"
 },
