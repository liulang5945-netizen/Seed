 "definition": {
  "provenance": "correct(items, authority=..., reason=...) records authority and reason in the audit log; provenance is not a second credential",
  "policy": "BridgeTable(allowed_authorities=(...)); empty means no policy and keeps the earlier behaviour; non-empty requires an authority from the list",
  "missing_authority": "with a non-empty policy, a correction without authority is rejected as rejected_batch_missing_authority before any row is planned",
  "unknown_authority": "with a non-empty policy, an authority not in the list is rejected as rejected_batch_unknown_authority",
  "allowed": "an allowed authority plus a reason is accepted and both are logged",
  "stale": "an allowed authority with a stale credential is still rejected as rejected_batch_correction_mismatch; provenance does not replace the CAS",
  "plain_write": "a plain conflicting write is still rejected; the policy does not change the write path",
  "default_table": "the 18-key table keeps the empty policy: alias round-trip returns the content digest, R15 stays 40/40, zeros stay 0/0, and the log authorities are empty",
  "chain": "a two-step chain under one allowed authority logs both steps with authority and reason",
  "rerun_anchors": "R18, R19 and R20 carry the commit at which their own runner bytes were last runnable, because R21 changes the bridge module their manifests pin",
  "closed_state": "the nine closed-state readings stay equal before and after"
 },
