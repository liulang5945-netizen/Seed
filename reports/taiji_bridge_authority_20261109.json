  "backward": "action corrected; one log entry with empty authority and reason",
  "missing": "action rejected_batch_missing_authority; content digest unchanged; log empty",
  "unknown": "action rejected_batch_unknown_authority; content digest unchanged; log empty",
  "allowed": "action corrected; one log entry with authority=verifier:v1 and reason=evidence:r21",
  "stale": "action rejected_batch_correction_mismatch; content digest unchanged; log empty",
  "plain_write": "action rejected_batch_address_already_bound; read CUP; log empty; content digest unchanged",
  "default_table": "content digest equal after the round trip; regression 40/40 with wrong 0; zeros 0/0; log length 2 and both authorities empty",
  "chain": "two corrected actions; read GREEN; log length 2; both authorities verifier:v1; reasons step1 and step2",
  "rerun": "every row names a commit, a runner blob sha1, a runner sha256 and the bridge sha256 used by the report",
  "closed_state": "the nine closed-state readings stay equal before and after",
  "reporting": "segments are reported separately; a policy rejection is evidence that the authority is checked, not evidence that the new value is correct"
 },
