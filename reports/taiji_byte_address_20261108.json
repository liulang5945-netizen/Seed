{
  "probe": "taiji_byte_address",
  "date": "2026-11-08",
  "question": "with the address generated by the 19.2r byte-match route instead of the mean-pooled vector, and with zero training, does the store recognise its own paraphrases while the never-written classes fall behind?",
  "preregistration": {
    "manifest": "plans/manifests/taiji_byte_address_20261108.json",
    "manifest_sha256": "5fbcd7a17a7f5af8bcd5d449d50f9a0fd8de23cf7ee5c83fa6371eea22eb1a7f",
    "written_before_any_reading": true
  },
  "criteria": {
    "B1_route_is_the_primitive": "the address is produced by ByteMatchRoute at its 19.2r initialisation: byte_embed equals eye(257, 256) exactly, position_weight equals 1 exactly, 0 updates, 0 optimizer steps; the free-offset search is the route's own (no injected offsets)",
    "B2_one_variable": "both arms read the same store: store keys, values, ages and count are byte-identical before and after every reading; only the read address differs (mean key vs byte route)",
    "B3_battery": "identical 154-query battery as the closed encoding line (22 paraphrases, 66 unwritten wordings, 3 negative classes of 22); the no_value class is a key-space midpoint with no textual form, so it has no byte query and is reported as not applicable",
    "B4_written_primary": "written face count = the write-back read: query the stored sentence itself, correct iff the winning line is the slot that sentence was written to",
    "B5_gaps": "the floor used for the class gaps is the minimum normalised alignment over the 22 paraphrases; the write-back floor is reported separately because it equals the maximum attainable score by construction and cannot test recognition",
    "B6_gate_frozen": "the copy gate is not modified and not retuned; its input remains the frozen mean key, so its verdict on the 22 correction faces is reported as inherited, not as caused by the byte address",
    "V1_holds": "written write-back >= 20 AND unwritten >= 60 AND at least two byte-expressible negative classes have a strictly positive gap AND the copy gate no longer refuses the 22 faces",
    "V2_not_discriminative": "every byte-expressible negative class has a normalised maximum >= 0.85 (near one) AND no class has a strictly positive gap: any two sentences of this template align about equally",
    "V3_inconclusive": "anything else: report the distributions only, no partial success",
    "near_one": "normalised alignment score >= 0.85",
    "unchanged": "no fixture, face, position, class, span or threshold is retuned after the first reading"
  },
