  "criteria": {
    "Z1_read_bytes": "with the switch off, all 154 battery reads through the wire are byte-identical to the frozen addressed_read: fast sha equal, identical top slot, max|delta| = 0",
    "Z2_probabilities": "with the switch off, the real forward over the 132 texts (22 written read wordings, 66 unwritten, 22 new_token, 22 new_pairing) produces identical probability bytes at every patch and an identical end state",
    "Z3_written_anchor": "the rebuilt store reproduces today exactly: keys/values/age sha and count equal the closed-line arm A, written floor 0.964818299 and 8/22 own-slot hits",
    "Z4_identity": "parameter tensors, parameter elements, state bytes and candidate_sha_v2 are equal before and after the disabled wire is used; the value must be the 20.3a CF1 store sha",
    "Z5_no_half_open": "with the switch off the boundary returns the same state object, allocates nothing, and the only enabled checks in the wire are the three entry-point early returns",
    "S1_no_loss": "session A writes 28/32 slots; the boundary grows to 64; session B writes 4 more",
    "S2_pass": "dropped_writes = 0, evictions = 0, the 28 session-A slots are byte-identical after growth, and each session-A text reads back a slot inside the prefix whose stored key is byte-identical to the key written for it; h_slots after >= 0.125.  The fixture's 8 base texts are identical by construction, so they share one address and value equality is reported separately, never used for the verdict",
    "T1_two_rules": "the simplified gate is exactly two rules: capacity (grow before writing when the session reserve is short; refuse, never evict, when capped) and copy (a write whose direction is a copy of the occupied span is refused)",
    "T2_count": "the 22 correction faces are read with their own read wording in both arms; correct = the top slot is the slot the face's write landed in",
    "V1": "Z fails -> zero_perturbation_failed, hard stop",
    "V2": "Z passes but any drop/eviction in the smoke -> growth_boundary_breaks",
    "V3": "all pass -> growth_wired_default_off; whether training is needed is still open",
    "unchanged": "no fixture, face, position, reserve ratio, growth factor or gate rule is retuned"
  },
