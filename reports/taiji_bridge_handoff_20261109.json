  "child_policy": "child policy is verifier:v1; a correction from verifier:v2 must be rejected_batch_unknown_authority, then verifier:v1 must be accepted",
  "digest_chain": "child imported digest equals parent digest; child exported digest equals parent-imported digest after the handback",
  "corrupt_child": "a second child receives truncated bytes and must reject them with a ValueError whose message starts with rejected_import_invalid_state; it must not write an output table",
  "closed_state": "the nine closed-state readings stay equal before and after"
 },
