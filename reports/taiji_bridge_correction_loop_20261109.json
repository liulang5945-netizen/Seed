 "definition": {
  "loop": "one iteration = read the key, compare the read value with the frozen verifier, and if they differ call correct(key, read_value, verifier_value); the read value is the credential",
  "one_step": "initial CUP, verifier RED: the loop must read CUP, correct to RED and read RED back",
  "read_credential": "initial RED, verifier GREEN: the correction must present RED (the read value), not a hard-coded CUP",
  "no_op": "when the read already equals the verifier, no correction is issued and the log stays empty",
  "stale_read": "a read captured before another actor corrects the address is a stale credential; using it must be rejected whole and the newer value must stay",
  "wrong_verifier": "the table holds CUP, the verifier says GREEN; the loop accepts the correction because the protocol checks only the old value -- reported as a declared boundary",
  "plain_write": "a plain write of the old value is still rejected; correction is the only path",
  "convergence": "two iterations: the first corrects, the second sees agreement and stops; exactly one log entry",
  "default_table": "on the 18-key table, correct an alias to another value and back; content digest returns to the original, R15 stays 40/40, zeros stay 0/0",
  "closed_state": "the nine closed-state readings stay equal before and after"
 },
 "criteria": {
  "one_step": "read CUP, action corrected, read RED, log length 1 with from=CUP and to=RED",
  "read_credential": "read RED, action corrected, read GREEN, log from=RED and to=GREEN",
  "no_op": "no correction, read CUP, log length 0, content digest unchanged",
  "stale_read": "action rejected_batch_correction_mismatch, read RED, log length 1, content digest unchanged",
  "wrong_verifier": "action corrected, read GREEN, log length 1, verifier_error_accepted true and final_matches_ground_truth false -- the boundary is declared, not hidden",
  "plain_write": "action rejected_batch_address_already_bound, read CUP, log length 0, content digest unchanged",
  "convergence": "two reads, one correction, log length 1, final RED",
  "default_table": "content digest after the round trip equals before; regression 40/40 with wrong 0; zeros 0/0; log length 2",
  "closed_state": "the nine closed-state readings stay equal before and after",
  "reporting": "segments are reported separately; the wrong-verifier segment is evidence of a boundary, not evidence that the loop understands correctness"
 },
