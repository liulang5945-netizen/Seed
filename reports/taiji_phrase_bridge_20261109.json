 "definition": {
  "bank": "the 9 (phrase, name) pairs from OBJECT_DESCRIPTIONS (4) and PLACE_DESCRIPTIONS (5).  Names are never bridge input: they are the regression target and the candidate set.",
  "bridge": "closed-form ridge W = (X^T X + lambda I)^-1 X^T N, where N holds the slot's name embeddings; the read-out is x W, classified by nearest name by cosine.",
  "column_before": "fit on all n rows and read every row back (in-sample).  Establishes that the table itself is representable; it is not a generalisation reading.",
  "column_after": "leave-one-out: for each held-out row fit on the other n-1 rows and read that row.  The bank therefore drops 4->3 (object) or 5->4 (place): one entry removed per item.  The removed name stays a candidate, so the answer is not excluded by construction.",
  "modes": {
   "phrase": "fit and test on the phrase vectors (same-domain phrase->name arrow).",
   "sentence": "fit on the phrase bank and read the describe sentence (cross-domain: this is the pipeline R9 makes possible).  Runs at the primary lambda only."
  },
  "lambda": "verdict at lambda = 1.0, fixed before the first reading.  The grid {1e-3, 1e-1, 1, 1e1, 1e3} is reported as robustness and is used only to reject the memorised claim.",
  "arms": {
   "R1": "LivingCoreReference.content_feature (128-bin byte histogram, L2-normalised).",
   "R2": "mean of reference.encoder.context(raw) over positions (128 dims), untrained weights.",
   "R3": "DocumentEmbedder on the frozen sentence-transformer; upper bound only."
  },
  "chance": {
   "object": 0.25,
   "place": 0.2
  }
 },
 "criteria": {
  "control": "machinery control: R1 in-sample accuracy must be >= 0.95 on both slots at lambda 1.0.  If it is not, the closed-form path is broken and the round is control_failed.",
  "generalises": "phrase_name_bridge_generalises iff R3 place leave-one-out >= 0.80 at lambda 1.0.",
  "memorised": "phrase_name_bridge_memorised iff R3 place leave-one-out <= 0.60 at every lambda in the grid; otherwise bridge_inconclusive.",
  "project_side": "computed on R2 only (D-20261109-10): project_bridge_generalises iff R2 place leave-one-out >= 0.80, project_bridge_memorised iff <= 0.60, else inconclusive.",
  "r3_unavailable": "if the R3 weights are not cached the verdict is r3_unavailable.",
  "no_fit": "0 training, 0 optimizer steps, 0 Adam, 0 confirm, 0 new parameters."
 },
 "lambda_grid": [
