 "definition": {
  "correction": "correct(items) is compare-and-swap: each item is (text, expected_value, new_value); the expected value is the credential, the whole batch is validated before mutation, and every applied row is appended to an audit log",
  "plain_write": "a plain write of a conflicting value is still rejected with the first writer kept; correction is a separate method, not a new conflict rule and not a parameter",
  "stale_credential": "a correction whose expected value is not the currently bound value is rejected whole; nothing moves, the audit log does not grow",
  "unknown_address": "a correction of a key that was never written is rejected whole",
  "batch_collision": "one correction batch cannot bind the same key to two different new values; the batch is rejected before any row is applied",
  "chain": "v1 -> v2 -> v3 must leave three audited steps in order and read v3",
  "round_trip": "on the 18-key table, correct an alias to another value and back; content digest returns to the original, R15 stays 40/40, zeros stay 0/0, and the log has two entries",
  "rerun_anchors": "R16 and R17 carry the commit at which their own runner bytes were last runnable, because R18 changes the bridge module their manifests pin",
  "closed_state": "the nine closed-state readings stay equal before and after"
 },
 "criteria": {
  "plain_write": "action rejected_batch_address_already_bound, content digest unchanged, read still the original value, corrections log empty",
  "correction": "action corrected, one row applied, read the new value, log length 1 with from=old and to=new, corrected count 1",
  "stale_credential": "action rejected_batch_correction_mismatch, content digest unchanged, read the corrected value, log length unchanged",
  "unknown_address": "action rejected_batch_unknown_address, content digest unchanged, log length unchanged",
  "batch_collision": "action rejected_batch_address_collision, content digest unchanged, read the original value, log empty",
  "chain": "two corrections applied, log from/to sequence is old -> middle -> final, read final",
  "round_trip": "content digest after the round trip equals the digest before it; alias reads the original value; regression 40/40 with wrong 0; zeros 0/0; log length 2",
  "rerun": "every row names a commit, a runner blob sha1, a runner sha256 and the bridge sha256 used by the report; a mismatch is declared in the row rather than hidden",
  "closed_state": "the nine closed-state readings stay equal before and after",
  "reporting": "segments are reported separately; a successful correction does not carry the rejection segments, and a rejected correction is evidence that the credential is checked"
 },
